.venv/
__pycache__/
.ipynb_checkpoints/
# generated data, checkpoints and logs stay local; figures are versioned for LEARNING.md
outputs/*
!outputs/figures/
# JEPA results: only small files are versioned (figures, result JSON/CSV); checkpoints, data and
# W&B folders stay local (checkpoints go to a GitHub Release)
!outputs/jepa/
outputs/jepa/**
!outputs/jepa/**/
!outputs/jepa/**/*.png
!outputs/jepa/**/*.json
!outputs/jepa/**/*.csv
outputs/jepa/**/wandb/
# Stage 15 results: only small files are versioned (figures, result JSON/CSV); checkpoints stay local
# (they go to a GitHub Release)
!outputs/stage15/
outputs/stage15/**
!outputs/stage15/**/
!outputs/stage15/**/*.png
!outputs/stage15/**/*.json
!outputs/stage15/**/*.csv
outputs/stage15/**/wandb/
